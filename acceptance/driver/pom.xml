<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- A throwaway Bukkit plugin that makes things happen on demand.

         A bare server has no players, so nothing the plugin logs will ever occur by
         itself: no joins, no deaths, no chat. This fires those events on request so the
         acceptance suite can assert what the plugin does with them.

         Never shipped, never published, and installed only into a temporary server
         directory that is deleted with the test.

         Compiled against the 1.8 API and Java 8 so the same JAR loads on every version
         under test. Paper implements Spigot implements Bukkit, so building against the
         oldest is what makes one artifact work from 1.8.0 to 26.2. -->

    <groupId>com.discordlogger</groupId>
    <artifactId>discordlogger-driver</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>DiscordLogger Acceptance Driver</name>

    <properties>
        <maven.compiler.release>8</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.8-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Generates the fake player.
             java.lang.reflect.Proxy cannot implement Player on any 1.8 build: that
             era's Bukkit declares getHealth() twice with different return types, and
             Proxy refuses outright. The restriction is Java's rather than the JVM's:
             two methods differing only in return type are legal bytecode and illegal
             source, so emitting the class directly is the only way past it.
             Shaded and relocated: this is a plugin loaded into somebody's server. -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>1.14.19</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>DiscordLoggerDriver</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation>
                                    <pattern>net.bytebuddy</pattern>
                                    <shadedPattern>com.discordlogger.driver.shaded.bytebuddy</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
