<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- A throwaway Bukkit plugin that makes things happen on demand.

         A bare server has no players, so nothing the plugin logs will ever occur by
         itself: no joins, no deaths, no chat. This fires those events on request so the
         acceptance suite can assert what the plugin does with them.

         Never shipped, never published, and installed only into a temporary server
         directory that is deleted with the test.

         Compiled against the 1.8 API and Java 8 so the same JAR loads on every version
         under test. Paper implements Spigot implements Bukkit, so building against the
         oldest is what makes one artifact work from 1.8.0 to 26.2. -->

    <groupId>com.discordlogger</groupId>
    <artifactId>discordlogger-driver</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>DiscordLogger Acceptance Driver</name>

    <properties>
        <maven.compiler.release>8</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.8-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>DiscordLoggerDriver</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
