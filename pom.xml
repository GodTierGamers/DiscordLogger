<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.discordlogger</groupId>
    <artifactId>discordlogger</artifactId>
    <version>2.4.0</version>
    <name>DiscordLogger</name>
    <description>Logs server events to a Discord channel via webhooks.</description>
    <url>https://github.com/GodTierGamers/DiscordLogger</url>

    <properties>
        <!-- Java 8. Bytecode is a hard gate: a runtime physically cannot load a class
             file compiled for a newer release, and Minecraft 1.13 through 1.16 run on
             Java 8. Targeting anything higher would mean the plugin loads on none of
             them, whatever plugin.yml claims.

             This is what the backport actually cost in the source: 15 records became
             final classes, and three small shims stand in for JDK 9-11 APIs —
             util.Strings, util.Io and util.Http. -->
        <maven.compiler.release>8</maven.compiler.release>

        <!-- Tests are compiled at 17, deliberately.
             Only the plugin bytecode has to be Java 8; the tests never enter the
             JAR and only ever run on the build JDK. Dragging them down to 8 as
             well would mean rewriting working text blocks and pattern matches for
             no gain, and would make the test sources harder to read than the code
             they cover. -->
        <maven.compiler.testRelease>17</maven.compiler.testRelease>

        <!-- The JDK the build RUNS on, which is not the same thing as the bytecode
             it produces. Every workflow reads this to decide which Temurin to
             install.

             It used to read <maven.compiler.release> for that, which was fine while
             the two were the same number and became a build-breaking bug the moment
             they were not: dropping the target to 8 would have had CI install JDK 8,
             which cannot compile the tests at 17 and cannot run the current Maven
             plugins at all. Keep this at the JDK the project is developed on; change
             the release property, above, to change what the plugin runs on. -->
        <dl.build.jdk>17</dl.build.jdk>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Compile against the OLDEST supported API, never the newest. Building
             against a newer one and declaring an older api-version is how you ship a
             plugin that loads and then dies on NoSuchMethodError: the compiler
             happily links methods the old server does not have.

             Spigot rather than Paper, so one JAR serves both — Paper implements the
             Bukkit API, so nothing is given up by compiling against the smaller of
             the two.

             This is 1.13.0, the lowest artifact of the 1.13 line and the lowest at
             which the two post-floor listeners still compile. Everything else is held
             to dl.compat.floor below by the compat-floor job, so building here does
             not quietly widen what the core may call. 1.13.1 and 1.13.2 each added
             API a 1.13.0 server lacks, which is why this is not simply "1.13.x". -->
        <spigot.api.version>1.13-R0.1-SNAPSHOT</spigot.api.version>

        <!-- The API artifact itself, so CI can swap Spigot for pure Bukkit rather than
             only changing the version. See the bukkit-api profile below. -->
        <dl.api.groupId>org.spigotmc</dl.api.groupId>
        <dl.api.artifactId>spigot-api</dl.api.artifactId>

        <!-- The oldest API the plugin promises to run on, enforced by CI's
             compat-floor job. It is LOWER than spigot.api.version above, and the gap
             is the point rather than an oversight.

             Three listeners name events that arrived after the floor:
             PlayerAdvancementDoneEvent (1.12), PlayerCommandSendEvent (1.13) and
             BlockExplodeEvent (1.8.3).
             They are built against the 1.13 API like everything else, so their logic
             stays compile-checked and unit-tested, and util.Compat only reflects over
             their construction, so a server without the event never loads the class.

             The compat-floor job compiles everything EXCEPT those two against this
             version (see the compat-floor profile below), which is what proves the
             other eighty-odd files really are floor-clean. Without that job, a core
             file reaching for a 1.9+ API would compile, test, ship, and only then
             NoSuchMethodError on the servers the listings promise. -->
        <dl.compat.floor>1.8-R0.1-SNAPSHOT</dl.compat.floor>

        <!-- SINGLE SOURCE OF TRUTH for the versions humans would otherwise retype.
             Everything downstream derives from these: plugin.yml via Maven
             filtering, the CI workflows by reading this file, and the website +
             README via scripts/sync-versions.py. Change them here, nowhere else. -->
        <dl.api.version>1.13</dl.api.version>

        <!-- Minecraft versions advertised on the Modrinth and Hangar listings when a
             stable release is published. This is the one value that cannot be derived
             from anything else in the build: api-version sets the *minimum* a server
             must implement, but which concrete Minecraft releases to list is an
             editorial call. Keep it in step with dl.api.version. Every entry is
             checked against Modrinth's known-version list before publishing, so a
             typo or an invented version fails the release rather than mislabelling it. -->
        <dl.game.versions>1.8,1.8.1,1.8.2,1.8.3,1.8.4,1.8.5,1.8.6,1.8.7,1.8.8,1.8.9,1.9,1.9.1,1.9.2,1.9.3,1.9.4,1.10,1.10.1,1.10.2,1.11,1.11.1,1.11.2,1.12,1.12.1,1.12.2,1.13,1.13.1,1.13.2,1.14,1.14.1,1.14.2,1.14.3,1.14.4,1.15,1.15.1,1.15.2,1.16,1.16.1,1.16.2,1.16.3,1.16.4,1.16.5,1.17,1.17.1,1.18,1.18.1,1.18.2,1.19,1.19.1,1.19.2,1.19.3,1.19.4,1.20,1.20.1,1.20.2,1.20.3,1.20.4,1.20.5,1.20.6,1.21,1.21.1,1.21.2,1.21.3,1.21.4,1.21.5,1.21.6,1.21.7,1.21.8,1.21.9,1.21.10,1.21.11,26.1,26.1.1,26.1.2,26.2</dl.game.versions>

        <!-- Build channel/date are stamped by CI (-Ddl.build.channel=stable|nightly,
             -Ddl.build.date=DD-MM-YYYY). A plain local `mvn package` gets "dev",
             so a hand-built JAR is never mistaken for a release artifact. -->
        <dl.build.channel>dev</dl.build.channel>
        <dl.build.date>unknown</dl.build.date>

        <junit.version>6.1.3</junit.version>
        <surefire.version>3.5.6</surefire.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <!-- Adventure ships as many small artifacts and the platform module pulls an
         older line of them than MiniMessage does (4.13.1 against 4.17.0). Mixing
         those is how you get a NoSuchMethodError at runtime rather than a compile
         error, so pin the whole family from the BOM. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>net.kyori</groupId>
                <artifactId>adventure-bom</artifactId>
                <version>4.17.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Tests. ConfigMigrator is the reason this exists: it decides whether a
             user's settings survive an upgrade, and a silent break there is the
             worst failure this plugin has. CI runs `mvn clean package` with tests
             on, so these gate every PR. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Paper API provided by the server at runtime; paper-api is required
             for Paper-specific events such as AsyncChatEvent. -->
        <dependency>
            <groupId>${dl.api.groupId}</groupId>
            <artifactId>${dl.api.artifactId}</artifactId>
            <version>${spigot.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Adventure, shaded.
             Paper hands these out for free; Spigot does not, and the plugin now
             compiles against Spigot so that one JAR serves both. lang.yml is
             documented as accepting hex, gradients, click and hover, so
             serialising to legacy section codes on the way out is not an option:
             it would silently drop all four on the 1.19+ servers that are the
             entire current audience. adventure-platform-bukkit keeps Components
             all the way to the player and downsamples them itself on servers too
             old to render them. It supports 1.8.8 up, so the later phases of the
             backport are already covered. -->
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-platform-bukkit</artifactId>
            <version>4.3.4</version>
            <scope>compile</scope>
            <exclusions>
                <!-- A build-time annotation only. It is never read at runtime and it
                     is the one com.google package the relocation does not cover, so
                     shipping it would put an unrelocated class in the JAR for nothing. -->
                <exclusion>
                    <groupId>com.google.auto.service</groupId>
                    <artifactId>auto-service-annotations</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-minimessage</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Gson, shaded.
             Adventure's Bukkit serialiser needs it, and spigot-api declares it as
             provided, so the build was quietly relying on the server to supply it.
             Modern Paper does; CraftBukkit 1.8 does not expose it to the plugin
             classloader, and the first chat line there died with
             NoClassDefFoundError: com/google/gson/JsonParseException.

             Bundling it removes the assumption entirely rather than degrading to
             legacy colour codes on servers that would otherwise render Components
             perfectly well. Relocated with the rest, so it cannot collide with
             whatever Gson the server has. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>compile</scope>
        </dependency>

        <!-- Test scope only. LangTest renders every chat message to plain text to
             prove its MiniMessage actually parses (an unclosed tag does not throw,
             it just shows up literally in game). Nothing in the plugin needs the
             plain serializer, so it stays out of the shaded JAR. -->
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-plain</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Anonymous usage metrics (bstats.org). Shaded + relocated below:
             bStats REQUIRES relocation so copies bundled by different plugins
             don't collide at runtime. -->
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
            <version>3.2.1</version>
            <scope>compile</scope>
        </dependency>

        <!-- YAML parsing for config migration (parsing-only) -->
        <!-- Bukkit has bundled SnakeYAML since forever, so take the server's copy
             rather than shading one. Shading a second, newer SnakeYAML is what broke
             the build the moment the API moved to Spigot: Bukkit's own
             YamlConfiguration calls `new Representer()`, which 2.x removed, so the
             shaded copy won the classpath and Bukkit could no longer read a YAML
             file. Using the platform's copy also drops it from the JAR.

             The constraint this puts on us: only API present in every bundled
             version, 1.23 through 2.x. That is `new Yaml().load(String)` and
             nothing else, which is all ConfigMigrator ever used. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>1.23</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- include all resources unfiltered (config.yml, etc.), EXCEPT plugin.yml
                 and build-info.properties -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                    <exclude>build-info.properties</exclude>
                </excludes>
            </resource>

            <!-- include ONLY plugin.yml + build-info.properties with filtering,
                 so ${project.version} / ${dl.build.channel} / ${dl.build.date} work -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                    <include>build-info.properties</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>com.discordlogger.shaded.bstats</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>net.kyori</pattern>
                                    <shadedPattern>com.discordlogger.shaded.kyori</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>com.discordlogger.shaded.gson</shadedPattern>
                                </relocation>
                            </relocations>
                            <!-- Disable to avoid ASM parsing issues with modern bytecode -->
                            <minimizeJar>false</minimizeJar>
                            <!-- dependency-reduced-pom.xml only matters when publishing to a
                                 Maven repo (so consumers don't inherit shaded deps). This
                                 plugin ships as a JAR on GitHub Releases and is never consumed
                                 as a Maven artifact, so don't generate it at all. -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>

            <!-- maven.compiler.release in <properties> drives the compiler; no
                 override here. Targeting 25 to match Minecraft 26.x, which requires
                 a Java 25 runtime — so the emitted bytecode can't load on older
                 Java. See ARCHITECTURE.md for what that means for compatibility. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Used only by CI's compat-floor job: mvn compile -Pcompat-floor
             -Dspigot.api.version=${dl.compat.floor}

             The two excluded files are the ones that legitimately name post-floor
             events. Everything else must compile against the floor, and this profile
             is what makes that a machine-checked claim rather than an intention.
             Excluding them here is safe precisely because nothing references them
             directly any more: util.Compat builds them by name. -->
        <profile>
            <id>compat-floor</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/listener/player/PlayerAdvancement.java</exclude>
                                <exclude>**/command/CommandVisibility.java</exclude>
                                <exclude>**/listener/server/BlockExplosion.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>