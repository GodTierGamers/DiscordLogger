        {
          "id": "book",
          "label": "Book Signed",
          "configKey": "log.player.book.enabled",
          "colorKey": "player.book",
          "defaultColor": "#E67E22",
          "default": true,
          "webhookKey": "player.book"
        },
        {
          "id": "bucket",
          "label": "Bucket Emptied",
          "configKey": "log.player.bucket.enabled",
          "colorKey": "player.bucket",
          "defaultColor": "#3498DB",
          "default": false,
          "extras": [
            {
              "key": "player.bucket.lava",
              "configKey": "log.player.bucket.lava",
              "label": "Log lava being placed",
              "note": "The griefing half. Lava placed indoors is almost never an accident.",
              "default": true
            },
            {
              "key": "player.bucket.water",
              "configKey": "log.player.bucket.water",
              "label": "Log water being placed",
              "note": "An MLG water bucket is an ordinary survival move, so on a busy server this is most of what the event posts. Untick it first if the channel is noisy.",
              "default": true
            }
          ],
          "note": "Off by default. Milk, a fish and powder snow are never logged -- they place nothing worth a record.",
          "webhookKey": "player.bucket"
        },
        {
          "id": "item_frame",
          "label": "Item Frame Broken",
