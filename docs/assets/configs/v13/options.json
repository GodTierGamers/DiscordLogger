              "key": "player.item_frame.players_only",
              "configKey": "log.player.item_frame.players_only",
              "label": "Only log frames broken by players",
              "note": "Skeletons, creepers and stray arrows break frames too. Logging those turns a rare message into noise.",
              "default": true
