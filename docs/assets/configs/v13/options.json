    {
      "id": "server",
      "label": "Server Events",
      "description": "Lifecycle and console events.",
      "items": [
        {
          "id": "start",
          "label": "Server Start",
          "configKey": "log.server.start.enabled",
          "colorKey": "server.start",
          "defaultColor": "#43B581",
          "default": true,
          "webhookKey": "server.start"
        },
        {
          "id": "stop",
          "label": "Server Stop",
          "configKey": "log.server.stop.enabled",
          "colorKey": "server.stop",
          "defaultColor": "#ED4245",
          "default": true,
          "webhookKey": "server.stop"
        },
        {
          "id": "command",
          "label": "Server Command",
          "configKey": "log.server.command.enabled",
          "colorKey": "server.command",
          "defaultColor": "#EB459E",
          "default": true,
          "webhookKey": "server.command"
        },
        {
          "id": "explosion",
          "label": "Explosion",
          "configKey": "log.server.explosion.enabled",
          "colorKey": "server.explosion",
          "defaultColor": "#E74C3C",
          "default": false,
          "webhookKey": "server.explosion",
          "extras": [
            {
              "key": "server.explosion.history.enabled",
              "configKey": "log.server.explosion.history.enabled",
              "label": "Keep a searchable record of every explosion",
              "note": "Writes explosions.csv in the plugin folder so /discordlogger lookup can find one by place later. Off writes no file.",
              "default": true
            },
            {
              "key": "server.explosion.history.expiry_time",
              "configKey": "log.server.explosion.history.expiry_time",
              "label": "Keep records for",
              "type": "text",
              "placeholder": "30d",
              "note": "Minutes through years: 30m, 2h, 7d, 4w, 6mo, 1y. Months and years follow the calendar. A bare number means days, and 0 keeps everything.",
              "default": "30d"
            },
            {
              "key": "server.explosion.history.show_tip",
              "configKey": "log.server.explosion.history.show_tip",
              "label": "Show the lookup command on the embed",
              "note": "Adds the exact /discordlogger lookup command for that spot, so staff do not have to retype coordinates.",
              "default": true
            }
          ],
          "note": "Off by default: the noisiest event here. The history option below still records every explosion for /discordlogger lookup while this is off."
        },
        {
          "id": "fire",
          "label": "Fire Lit",
          "configKey": "log.server.fire.enabled",
          "colorKey": "server.fire",
          "defaultColor": "#F39C12",
          "default": false,
          "note": "Off by default: fire spreads, so one lit block becomes hundreds of events. The ignite-cause filter already drops the two causes that multiply.",
          "webhookKey": "server.fire"
        },
        {
          "id": "plugin",
          "label": "Plugin Enabled/Disabled",
          "configKey": "log.server.plugin.enabled",
          "colorKey": "server.plugin",
          "defaultColor": "#95A5A6",
          "default": true,
          "webhookKey": "server.plugin"
        },
        {
          "id": "lag",
          "label": "Server Lag",
          "configKey": "log.server.lag.enabled",
          "colorKey": "server.lag",
          "defaultColor": "#D35400",
          "default": true,
          "extras": [
            {
              "key": "server.lag.threshold_tps",
              "configKey": "log.server.lag.threshold_tps",
              "label": "Warn below this TPS",
              "note": "20 is a healthy server. 15 is noticeable; below 10 is unplayable.",
              "type": "text",
              "default": "15.0"
            },
            {
              "key": "server.lag.cooldown_minutes",
              "configKey": "log.server.lag.cooldown_minutes",
              "label": "Minutes between warnings",
              "note": "A struggling server stays struggling, so this stops one outage filling the channel.",
              "type": "text",
              "default": "10"
            }
          ],
          "webhookKey": "server.lag"
        }
      ]
    },
